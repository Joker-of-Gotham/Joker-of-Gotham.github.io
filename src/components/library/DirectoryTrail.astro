---
import {getDirectories,type DirectorySection} from '@/lib/content/directory-queries';
import {ancestors,parentPath} from '@/lib/content/directories';
import {sectionLabels} from '@/lib/content/library';
import ContentNavigation from '@/components/ui/ContentNavigation.astro';
interface Props {section:DirectorySection; id?:string; path?:string;}
const {section,id,path = parentPath(id ?? '')}=Astro.props;
const dirs=await getDirectories(section);
const items=ancestors(path).map(p=>dirs.find(d=>d.path===p)).filter(d=>Boolean(d)).map(d=>({label:d!.path ? d!.title : sectionLabels[section],href:d!.href}));
if (!items.length) items.push({label:sectionLabels[section],href:`/${section}/`});
---
<ContentNavigation items={items} />
