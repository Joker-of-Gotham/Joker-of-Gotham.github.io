---
interface Props { title?: string; crumbs?: { label: string; href?: string }[]; home?: boolean; }
const { home = false } = Astro.props;
const pathname = Astro.url.pathname;
---
<header class="site-nav observatory-nav-shell" transition:name="site-navigation">
  <button class="site-menu" id="drawer-toggle" type="button" aria-label="打开主导航" aria-controls="site-sidebar" aria-expanded="false">
    <span aria-hidden="true">≡</span><span class="site-menu-label">导航</span>
  </button>
  <a class="observatory-brand" href={home ? '#signal-gate' : '/'}>Komari</a>
  <nav class="home-site-nav" aria-label="主导航">
    <a href="/blog/" aria-current={pathname.startsWith('/blog/') ? 'page' : undefined}>博客</a>
    <a href="/research/" aria-current={pathname.startsWith('/research/') ? 'page' : undefined}>研究</a>
    <a href="/reading/" aria-current={pathname.startsWith('/reading/') ? 'page' : undefined}>阅读</a>
    <a href="/musings/" aria-current={pathname.startsWith('/musings/') ? 'page' : undefined}>杂谈</a>
    <a href="/artifacts/" aria-current={pathname.startsWith('/artifacts/') ? 'page' : undefined}>作品</a>
    <a href="/about/" aria-current={pathname.startsWith('/about/') ? 'page' : undefined}>关于</a>
  </nav>
  <div class="observatory-nav-actions">
    <a class="observatory-control" href="/search/" data-command-palette-trigger aria-label="搜索文章" aria-haspopup="dialog" aria-controls="command-root" aria-expanded="false">搜索</a>
    <button class="observatory-control theme-icon-toggle" type="button" data-theme-toggle data-observatory-theme-toggle aria-label="切换主题" aria-pressed="false">
      <svg class="theme-icon theme-icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
      <svg class="theme-icon theme-icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 13.4A8.5 8.5 0 0 1 10.6 3.5 8.5 8.5 0 1 0 20.5 13.4Z"/></svg>
    </button>
  </div>
</header>
<noscript>
  <style is:inline>
    body .site-nav .site-menu, body .site-nav [data-theme-toggle] { display: none; }
    @media(max-width:960px) {
      body .site-nav { position: relative; flex-wrap: wrap; }
      body .site-nav .home-site-nav { display: flex; flex-wrap: wrap; order: 4; width: 100%; justify-content: space-between; gap: .5rem; }
      body .site-nav .home-site-nav a:last-child { display: flex; }
      body[data-shell-variant="standard"] .main-area { padding-top: 0; }
    }
  </style>
</noscript>
