---


interface Props {
  worldPlateDark?: string;
  worldPlateLight?: string;
  worldPlateDarkCompact?: string;
  worldPlateLightCompact?: string;
  worldPlateDarkPortrait?: string;
  worldPlateLightPortrait?: string;
}

const {
  worldPlateDark = "/assets/img/observatory/tsukuyomi-world-v14-dark.webp",
  worldPlateLight = "/assets/img/observatory/tsukuyomi-world-v14-light.webp",
  worldPlateDarkCompact = "/assets/img/observatory/tsukuyomi-world-v14-dark-compact.webp",
  worldPlateLightCompact = "/assets/img/observatory/tsukuyomi-world-v14-light-compact.webp",
  worldPlateDarkPortrait = "/assets/img/observatory/tsukuyomi-world-v14-dark-portrait.webp",
  worldPlateLightPortrait = "/assets/img/observatory/tsukuyomi-world-v14-light-portrait.webp"
} = Astro.props;
---

<div class="observatory-visual" data-observatory-visual aria-hidden="true" transition:persist="tsukuyomi-world">
  <picture>
  <source data-os-light-source media="(prefers-color-scheme: light) and (max-width: 720px)" srcset={worldPlateLightPortrait} />
  <source data-os-light-source media="(prefers-color-scheme: light)" srcset={worldPlateLight} />
  <source
    media="(max-width: 720px)"
    srcset={worldPlateDarkPortrait}
    data-observatory-portrait-source
    data-dark-source={worldPlateDarkPortrait}
    data-light-source={worldPlateLightPortrait}
  />
  <img
    class="observatory-world-plate"
    data-observatory-themed-visual
    data-observatory-world-plate
    data-dark-source={worldPlateDark}
    data-light-source={worldPlateLight}
    data-dark-compact-source={worldPlateDarkCompact}
    data-light-compact-source={worldPlateLightCompact}
    src={worldPlateDark}
    alt=""
    width="1440"
    height="900"
    decoding="async"
    fetchpriority="high"
  />
  </picture>
  <canvas class="observatory-canvas" data-observatory-canvas aria-hidden="true"></canvas>
</div>

<script>
  import { installObservatoryDomMotion } from "@/lib/observatory/dom-motion";

  installObservatoryDomMotion();
</script>
