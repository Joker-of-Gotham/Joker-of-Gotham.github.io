---
import "@/styles/observatory.css";
import type { ObservatoryEntry, ObservatoryHeroCopy } from "@/lib/observatory/types";
import ObservatoryCanvas from "./ObservatoryCanvas.astro";
import ObservatoryNav from "./ObservatoryNav.astro";
import HomeEntries from "./HomeEntries.astro";
interface Props { hero: ObservatoryHeroCopy; posts: ObservatoryEntry[]; artifacts: ObservatoryEntry[]; topics: ObservatoryEntry[]; }
const { hero, posts, artifacts, topics } = Astro.props;
---
<div class="observatory" data-observatory-root data-render-state="static" data-quality-tier="poster" data-world-version="12">
  <a class="observatory-skip-link" href="#signal-gate-title">跳到首页主要内容</a>
  <ObservatoryCanvas />
  <ObservatoryNav />
  <div class="observatory-chapters">
    <section id="signal-gate" data-observatory-chapter="signal-gate" aria-labelledby="signal-gate-title">
      <div class="observatory-chapter-frame home-intro">
        <h1 id="signal-gate-title">{hero.title}</h1>
        <p>研究、编程，以及日常。</p>
        <div class="home-links"><a href="/blog/?scene=signal-gate">阅读文章 <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>
    <section id="observe" data-observatory-chapter="observe" aria-labelledby="observe-title">
      <div class="observatory-chapter-frame home-writing">
        <h2 id="observe-title">文章</h2>
        <HomeEntries entries={posts} />
        <div class="home-links"><a class="home-more" href="/blog/?scene=observe">全部博客 <span aria-hidden="true">↗</span></a><a href="/musings/?scene=observe">生活杂谈 <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>
    <section id="structure" data-observatory-chapter="structure" aria-labelledby="structure-title">
      <div class="observatory-chapter-frame home-research home-bridge">
        <h2 id="structure-title">研究</h2>
        <div class="home-topic-links">{topics.map(topic => <a href={topic.href}>{topic.title}</a>)}</div>
        <div class="home-links"><a href="/research/?scene=structure">问题、研读与思考 <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>
    <section id="orchestrate" data-observatory-chapter="orchestrate" aria-labelledby="orchestrate-title">
      <div class="observatory-chapter-frame home-work">
        <h2 id="orchestrate-title">作品</h2>
        <HomeEntries entries={artifacts} />
        <a class="home-more" href="/artifacts/?scene=orchestrate">全部作品 <span aria-hidden="true">↗</span></a>
      </div>
    </section>
    <section id="embodiment" data-observatory-chapter="embodiment" aria-labelledby="embodiment-title">
      <div class="observatory-chapter-frame home-reading home-bridge">
        <h2 id="embodiment-title">阅读</h2>
        <div class="home-links"><a href="/reading/?scene=embodiment">书架与阅读札记 <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>
    <section id="archive-afterlight" data-observatory-chapter="archive-afterlight" aria-labelledby="archive-afterlight-title">
      <div class="observatory-chapter-frame home-farewell">
        <h2 id="archive-afterlight-title">关于我</h2>
        <div class="home-links home-project-links">
          <a href="/about/?scene=archive-afterlight">阅读简介 <span aria-hidden="true">↗</span></a>
          <a class="home-profile-link" href="https://github.com/Joker-of-Gotham">GitHub 主页 <span aria-hidden="true">↗</span></a>
          <a href="https://github.com/Moonweave-AI/virea">VIREA · 动作生成 <span aria-hidden="true">↗</span></a>
          <a href="https://github.com/Joker-of-Gotham/Zanao-LLM-Analyzer">Zanao · 集市分析 <span aria-hidden="true">↗</span></a>
          <a href="https://github.com/Moonweave-AI/governance">Governance · 工程治理 <span aria-hidden="true">↗</span></a>
          <a href="https://github.com/Moonweave-AI/Ontotect">Ontotect · 本体工程 <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </div>
</div>
<script>
  import { installObservatoryBootstrap } from "@/lib/observatory/bootstrap";
  installObservatoryBootstrap();
</script>
