---
import "@/styles/observatory.css";
import type {
  ObservatoryEntry,
  ObservatoryHeroCopy,
  ObservatoryMetric,
  ObservatorySignalWindow,
  ObservatoryTrack
} from "@/lib/observatory/types";
import ObservatoryCanvas from "./ObservatoryCanvas.astro";
import ObservatoryNav from "./ObservatoryNav.astro";
import SignalGate from "./chapters/SignalGate.astro";
import Observe from "./chapters/Observe.astro";
import Structure from "./chapters/Structure.astro";
import Orchestrate from "./chapters/Orchestrate.astro";
import Embodiment from "./chapters/Embodiment.astro";
import ArchiveAfterlight from "./chapters/ArchiveAfterlight.astro";

interface Props {
  hero?: ObservatoryHeroCopy;
  metrics?: ObservatoryMetric[];
  tracks?: ObservatoryTrack[];
  artifacts?: ObservatoryEntry[];
  posts?: ObservatoryEntry[];
  signals?: ObservatorySignalWindow[];
  avatarDarkSource?: string;
  avatarLightSource?: string;
  posterDark?: string;
  posterLight?: string;
}

const {
  hero = {
    eyebrow: "Implicit Signal Mining for Personalized Decision Systems",
    title: "Chika Komari",
    subtitle: "在结构、语义与心理信号之间，构造一条可验证的个性化决策路径。",
    description: "研究复杂信息网络中的隐式信号，也记录工程、阅读与长期思考如何彼此照亮。",
    primaryAction: { label: "进入研究档案", href: "/artifacts/" },
    secondaryAction: { label: "阅读最新文章", href: "/blog/" }
  },
  metrics = [],
  tracks = [],
  artifacts = [],
  posts = [],
  signals = [
    { src: "/assets/img/observatory/signal-bocchi.webp", alt: "乐队演奏中的粉发少女", eyebrow: "Band signal", caption: "Afterlight / Bocchi" },
    { src: "/assets/img/observatory/signal-april.webp", alt: "夕光中的少年与金发少女", eyebrow: "Memory signal", caption: "April resonance" },
    { src: "/assets/img/observatory/signal-gbc.webp", alt: "舞台灯光下的少女乐队成员", eyebrow: "Band signal", caption: "Girls Band Cry" },
    { src: "/assets/img/observatory/signal-komari.webp", alt: "教室窗边的黑发少女", eyebrow: "Daily signal", caption: "Chika Komari" },
    { src: "/assets/img/observatory/signal-kaguya.webp", alt: "暖色光线中的两位少女", eyebrow: "Afterlight", caption: "Lunar memory" }
  ],
  avatarDarkSource = "/assets/img/observatory/signal-guide-dark-sample.webp",
  avatarLightSource = "/assets/img/observatory/signal-guide-light-sample.webp",
  posterDark = "/assets/img/observatory/signal-guide-dark-poster.webp",
  posterLight = "/assets/img/observatory/signal-guide-light-poster.webp"
} = Astro.props;
---

<div
  class="observatory"
  data-observatory-root
  data-render-state="static"
  data-quality-tier="poster"
  data-avatar-state="poster"
  data-avatar-dark-source={avatarDarkSource}
  data-avatar-light-source={avatarLightSource}
>
  <a class="observatory-skip-link" href="#signal-gate-title">跳到首页主要内容</a>
  <ObservatoryCanvas posterDark={posterDark} posterLight={posterLight} />
  <ObservatoryNav />

  <div class="observatory-chapters">
    <SignalGate hero={hero} />
    <Observe metrics={metrics} />
    <Structure tracks={tracks} />
    <Orchestrate artifacts={artifacts} />
    <Embodiment />
    <ArchiveAfterlight posts={posts} signals={signals} />
  </div>
  <slot name="supplement" />
</div>

<script>
  import { installObservatoryBootstrap } from "@/lib/observatory/bootstrap";
  installObservatoryBootstrap();
</script>
