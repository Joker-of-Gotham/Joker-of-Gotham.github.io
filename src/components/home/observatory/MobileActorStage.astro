---
import type { ObservatoryGuidePoseId } from "@/lib/observatory/chapter-guide-poses";

interface Props {
  pose: ObservatoryGuidePoseId;
  chapter: string;
  cue: string;
}

const { pose, chapter, cue } = Astro.props;
---

<div class="observatory-mobile-actor-stage" data-pose={pose} aria-hidden="true">
  <span class="observatory-mobile-actor-meta">
    <small>{chapter}</small>
    <strong>{cue}</strong>
  </span>
  <span class="observatory-mobile-actor-orbit"></span>
  <span class="observatory-mobile-actor-figure"></span>
</div>
