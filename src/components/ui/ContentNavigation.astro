---
interface Props { items: { label: string; href: string }[]; }
const { items } = Astro.props;
const parent = items.at(-1);
---
{parent && <nav class="content-navigation" aria-label="文章与目录导航" data-pagefind-ignore>
  <a class="content-back" href={parent.href}><span aria-hidden="true">←</span> 返回上一级<span class="content-back-label">：{parent.label}</span></a>
  <ol aria-label="所属目录">{items.map(item => <li><a href={item.href}>{item.label}</a></li>)}</ol>
</nav>}
<style>
  .content-navigation { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-6); margin-block: var(--space-3) var(--space-6); color: var(--color-foreground-soft); font-size: var(--text-sm); }
  .content-navigation a { color: inherit; text-decoration: none; }
  .content-navigation a:hover { text-decoration: underline; text-underline-offset: .25em; }
  .content-navigation a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .content-back { display: inline-flex; align-items: center; min-height: 44px; gap: var(--space-2); font-weight: 600; }
  .content-navigation ol { display: flex; flex-wrap: wrap; align-items: center; gap: 0 var(--space-2); margin: 0; padding: 0; list-style: none; }
  .content-navigation li { display: flex; align-items: center; gap: var(--space-2); overflow-wrap: anywhere; }
  .content-navigation li + li::before { content: '/'; opacity: .5; }
  .content-navigation li a { display: inline-flex; align-items: center; min-height: 44px; }
  @media(max-width:720px) { .content-navigation { display: block; } .content-back-label { display: none; } }
</style>
