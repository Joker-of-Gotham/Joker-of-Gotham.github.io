---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/ui/Icon.astro";
import "@/styles/archive.css";

const quickKindTabs = [
  { label: "All", kind: "all" },
  { label: "Roadmap", kind: "roadmap" },
  { label: "Blog", kind: "blog" },
  { label: "Projects", kind: "project" },
  { label: "Papers", kind: "paper" },
  { label: "Artifacts", kind: "artifact" }
];
---

<BaseLayout
  title="Search"
  description="Search the Nocturne Research Archive across roadmap nodes, blog records, projects, papers, and artifacts."
  crumbs={[{ label: "Home", href: "/" }, { label: "Search" }]}
>
  <section class="archive-page archive-search-page" id="search-page" aria-labelledby="search-page-title">
    <header class="archive-masthead archive-masthead--search">
      <div class="archive-masthead-copy">
        <p class="archive-kicker"><span aria-hidden="true">A—04</span> Signal retrieval</p>
        <h1 id="search-page-title">Search</h1>
        <p class="archive-lead">Across every roadmap node, research note, project, paper, and materialized artifact.</p>
        <p class="archive-note">Filters are reflected in the URL, so every result set remains bookmarkable and shareable.</p>
      </div>
      <div class="archive-search-orbit" aria-hidden="true">
        <span>QUERY</span>
        <span>INDEX</span>
        <span>TRACE</span>
      </div>
    </header>

    <form class="archive-search-console" id="archive-search-form" role="search" aria-describedby="search-help search-result-status">
      <div class="archive-search-primary">
        <label class="sr-only" for="search-query-input">Search query</label>
        <div class="input icon-input-wrap search-input-wrap">
          <Icon name="search" size={16} />
          <input id="search-query-input" class="unstyled-input" type="search" placeholder="Search a title, topic, track, or signal…" autocomplete="off" aria-controls="search-result-list" />
        </div>
        <p class="archive-search-help" id="search-help">Results update as you type. Combine a record type with year, track, and execution status.</p>
      </div>

      <div class="archive-search-filters">
        <div class="filter-bar archive-kind-tabs" id="search-kind-tabs" aria-label="Record type">
          {
            quickKindTabs.map((tab) => (
              <button class={`tag-chip ${tab.kind === "all" ? "active" : ""}`} type="button" data-kind={tab.kind} aria-pressed={tab.kind === "all" ? "true" : "false"}>{tab.label}</button>
            ))
          }
        </div>

        <div class="filter-bar archive-select-filters">
          <label for="search-year">Year</label>
          <select id="search-year" aria-label="Filter by year">
            <option value="all">All year</option>
          </select>

          <label for="search-track">Track</label>
          <select id="search-track" aria-label="Filter by track">
            <option value="all">All track</option>
          </select>

          <label for="search-status">Status</label>
          <select id="search-status" aria-label="Filter by status">
            <option value="all">All status</option>
            <option value="done">Completed</option>
            <option value="now">Ongoing</option>
            <option value="blocked">Blocked</option>
            <option value="next">Planned</option>
            <option value="later">Pending</option>
          </select>
          <button class="button archive-search-reset" type="button" id="search-reset">Reset</button>
        </div>
      </div>
    </form>

    <section class="archive-search-results" aria-labelledby="search-results-title">
      <div class="archive-section-heading archive-section-heading--compact">
        <div>
          <p class="archive-kicker">Resolved signals</p>
          <h2 id="search-results-title">Results</h2>
        </div>
        <p class="archive-search-status" id="search-result-status" role="status" aria-live="polite">Loading archive index…</p>
      </div>
      <div class="search-result-list" id="search-result-list" role="list" aria-busy="true"></div>
      <div class="archive-empty-state" id="search-empty" hidden>
        <span aria-hidden="true">∅</span>
        <p>No matching signals.</p>
        <p>Try a broader keyword or reset one of the filters.</p>
      </div>
    </section>
  </section>

  <script is:inline>
    const root = document.getElementById("search-page");

    if (root) {
      const queryInput = document.getElementById("search-query-input");
      const form = document.getElementById("archive-search-form");
      const tabs = document.getElementById("search-kind-tabs");
      const yearSelect = document.getElementById("search-year");
      const trackSelect = document.getElementById("search-track");
      const statusSelect = document.getElementById("search-status");
      const resetButton = document.getElementById("search-reset");
      const list = document.getElementById("search-result-list");
      const empty = document.getElementById("search-empty");
      const resultStatus = document.getElementById("search-result-status");

      const STATUS_LABEL = {
        done: "Completed",
        now: "Ongoing",
        blocked: "Blocked",
        next: "Planned",
        later: "Pending"
      };

      const state = {
        q: "",
        kind: "all",
        year: "all",
        track: "all",
        status: "all"
      };

      let items = [];

      const escapeHtml = (str) => str
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/\"/g, "&quot;")
        .replace(/'/g, "&#39;");

      const updateUrl = () => {
        const params = new URLSearchParams();
        if (state.q) params.set("q", state.q);
        if (state.kind !== "all") params.set("kind", state.kind);
        if (state.year !== "all") params.set("year", state.year);
        if (state.track !== "all") params.set("track", state.track);
        if (state.status !== "all") params.set("status", state.status);
        const next = params.toString();
        window.history.replaceState({}, "", next ? `/search/?${next}` : "/search/");
      };

      const syncFromUrl = () => {
        const params = new URLSearchParams(window.location.search);
        state.q = params.get("q") || "";
        state.kind = params.get("kind") || "all";
        state.year = params.get("year") || "all";
        state.track = params.get("track") || "all";
        state.status = params.get("status") || "all";
      };

      const hydrateFilterOptions = () => {
        const years = new Set();
        const tracks = new Set();

        items.forEach((item) => {
          if (item.year) years.add(String(item.year));
          if (item.track) tracks.add(item.track);
        });

        Array.from(years).sort((a, b) => Number(b) - Number(a)).forEach((year) => {
          const option = document.createElement("option");
          option.value = year;
          option.textContent = year;
          yearSelect?.appendChild(option);
        });

        Array.from(tracks).sort((a, b) => a.localeCompare(b, "zh-CN")).forEach((track) => {
          const option = document.createElement("option");
          option.value = track;
          option.textContent = track;
          trackSelect?.appendChild(option);
        });
      };

      const matches = (item) => {
        const q = state.q.trim().toLowerCase();
        const haystack = `${item.title} ${item.summary} ${(item.tags || []).join(" ")} ${item.track || ""} ${item.type || ""}`.toLowerCase();

        const queryMatched = q.length === 0 || haystack.includes(q);
        const kindMatched = state.kind === "all" || item.kind === state.kind;
        const yearMatched = state.year === "all" || String(item.year || "") === state.year;
        const trackMatched = state.track === "all" || item.track === state.track;
        const statusMatched = state.status === "all" || item.status === state.status;

        return queryMatched && kindMatched && yearMatched && trackMatched && statusMatched;
      };

      const render = () => {
        if (!list) return;

        const filtered = items
          .filter(matches)
          .sort((a, b) => {
            const yearDelta = Number(b.year || 0) - Number(a.year || 0);
            if (yearDelta !== 0) return yearDelta;
            return a.title.localeCompare(b.title, "zh-CN");
          })
          .slice(0, 120);

        list.innerHTML = filtered
          .map((item, index) => {
            const statusLabel = item.status ? STATUS_LABEL[item.status] || item.status : "";
            const meta = [item.kind, item.track, item.type, item.year, statusLabel].filter(Boolean).join(" · ");
            const tags = (item.tags || []).slice(0, 4);

            return `
              <article class="archive-search-result" role="listitem">
                <a class="search-result-item" href="${escapeHtml(item.url)}">
                  <span class="archive-search-result-index" aria-hidden="true">${String(index + 1).padStart(2, "0")}</span>
                  <div class="archive-search-result-copy">
                  <div class="search-result-head">
                    <h3>${escapeHtml(item.title)}</h3>
                    <span class="tag-chip">${escapeHtml(item.kind)}</span>
                  </div>
                  ${item.summary ? `<p>${escapeHtml(item.summary)}</p>` : ""}
                  ${meta ? `<p class="meta-row">${escapeHtml(meta)}</p>` : ""}
                  ${tags.length > 0 ? `<div class="meta-row">${tags.map((tag) => `<span class=\"tag-chip\">${escapeHtml(tag)}</span>`).join("")}</div>` : ""}
                  </div>
                  <span class="archive-search-result-action" aria-hidden="true">↗</span>
                </a>
              </article>
            `;
          })
          .join("");

        if (empty) {
          empty.hidden = filtered.length > 0;
        }
        if (resultStatus) {
          resultStatus.textContent = `${filtered.length} of ${items.length} signals`;
        }
        list.setAttribute("aria-busy", "false");
      };

      const bindEvents = () => {
        queryInput?.addEventListener("input", (event) => {
          const target = event.target;
          if (!(target instanceof HTMLInputElement)) return;
          state.q = target.value;
          updateUrl();
          render();
        });

        yearSelect?.addEventListener("change", (event) => {
          const target = event.target;
          if (!(target instanceof HTMLSelectElement)) return;
          state.year = target.value;
          updateUrl();
          render();
        });

        trackSelect?.addEventListener("change", (event) => {
          const target = event.target;
          if (!(target instanceof HTMLSelectElement)) return;
          state.track = target.value;
          updateUrl();
          render();
        });

        statusSelect?.addEventListener("change", (event) => {
          const target = event.target;
          if (!(target instanceof HTMLSelectElement)) return;
          state.status = target.value;
          updateUrl();
          render();
        });

        tabs?.addEventListener("click", (event) => {
          const target = event.target.closest("[data-kind]");
          if (!(target instanceof HTMLButtonElement)) return;
          state.kind = target.dataset.kind || "all";
          updateUrl();
          render();
          tabs.querySelectorAll("[data-kind]").forEach((tab) => {
            const isActive = tab === target;
            tab.classList.toggle("active", isActive);
            tab.setAttribute("aria-pressed", isActive ? "true" : "false");
          });
        });

        form?.addEventListener("submit", (event) => event.preventDefault());

        resetButton?.addEventListener("click", () => {
          state.q = "";
          state.kind = "all";
          state.year = "all";
          state.track = "all";
          state.status = "all";
          applyControls();
          updateUrl();
          render();
          if (queryInput instanceof HTMLInputElement) queryInput.focus();
        });
      };

      const applyControls = () => {
        if (queryInput instanceof HTMLInputElement) queryInput.value = state.q;
        if (yearSelect instanceof HTMLSelectElement) yearSelect.value = state.year;
        if (trackSelect instanceof HTMLSelectElement) trackSelect.value = state.track;
        if (statusSelect instanceof HTMLSelectElement) statusSelect.value = state.status;
        tabs?.querySelectorAll("[data-kind]").forEach((tab) => {
          const isActive = tab.getAttribute("data-kind") === state.kind;
          tab.classList.toggle("active", isActive);
          tab.setAttribute("aria-pressed", isActive ? "true" : "false");
        });
      };

      const boot = async () => {
        const response = await fetch("/search-index.json", { cache: "no-store" });
        if (!response.ok) throw new Error("failed");
        items = await response.json();
        hydrateFilterOptions();
        syncFromUrl();
        applyControls();
        render();
        bindEvents();
      };

      boot().catch(() => {
        if (list) {
          list.setAttribute("aria-busy", "false");
          list.innerHTML = '<article class="archive-search-error" role="alert"><p>Failed to load the search index. Please refresh and try again.</p></article>';
        }
        if (resultStatus) {
          resultStatus.textContent = "Archive index unavailable";
        }
      });
    }
  </script>
</BaseLayout>
