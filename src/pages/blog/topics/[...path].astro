---
import DirectoryLayout from '@/layouts/DirectoryLayout.astro';
import {getDirectories} from '@/lib/content/directory-queries';
export async function getStaticPaths(){return (await getDirectories('blog')).filter(d=>d.path).map(d=>({params:{path:d.path}}));}
---
<DirectoryLayout section="blog" path={Astro.params.path!} />
