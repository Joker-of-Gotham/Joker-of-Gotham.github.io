---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogExplorer from "@/components/blog/BlogExplorer.astro";
import DirectoryIntroduction from '@/components/library/DirectoryIntroduction.astro';
import { getPublishedBlogPosts } from "@/lib/content/queries";
import { blogItems } from "@/lib/content/blog-items";
import "@/styles/archive.css";

const posts = await getPublishedBlogPosts();

const items = await blogItems(posts);
---

<BaseLayout
  title="Blog"
  description="Nocturne Research Archive — 按主题、时间与研究集合编目的技术长文。"
  crumbs={[{ label: "Home", href: "/" }, { label: "Blog" }]}
>
  <div class="archive-page archive-page--index archive-blog-index">
    <header class="archive-masthead" aria-labelledby="blog-archive-title">
      <div class="archive-masthead-copy">
        <p class="archive-kicker"><span aria-hidden="true">A—01</span> Nocturne Research Archive</p>
        <h1 id="blog-archive-title">Blog</h1>
      </div>
    </header>

    <section class="archive-catalogue">
      <DirectoryIntroduction section="blog" />
      <BlogExplorer items={items} />
    </section>
  </div>
</BaseLayout>

