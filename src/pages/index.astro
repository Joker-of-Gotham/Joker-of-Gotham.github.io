---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CommitActivity from "@/components/home/CommitActivity.astro";
import LunarObservatory from "@/components/home/observatory/LunarObservatory.astro";
import {
  formatDate,
  getArtifacts,
  getPublishedBlogPosts,
  getRoadmapNodes,
  getSiteConfig,
  normalizeSlug,
} from "@/lib/content/queries";
import { computeRoadmapPointSummary } from "@/lib/content/roadmapMetrics";
import type {
  ObservatoryEntry,
  ObservatoryHeroCopy,
  ObservatoryMetric,
  ObservatorySignalWindow,
  ObservatoryTrack,
} from "@/lib/observatory/types";

const [{ home }, posts, nodes, artifacts] = await Promise.all([
  getSiteConfig(),
  getPublishedBlogPosts(),
  getRoadmapNodes(),
  getArtifacts(),
]);

const normalizeCardSummary = (input: string) =>
  input
    .replace(/\r\n?/g, "\n")
    .replace(/<[^>]*>/g, " ")
    .replace(/^\s{0,3}>\s?/gm, " ")
    .replace(/^\s{0,3}#{1,6}\s+/gm, " ")
    .replace(/^\s*\{:\s*(?:\.[a-zA-Z0-9_-]+\s*)+\}\s*$/gm, " ")
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/\$\$[\s\S]*?\$\$/g, " ")
    .replace(/!\[[^\]]*\]\([^)]+\)/g, " ")
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
    .replace(/[*_`~#>]+/g, " ")
    .replace(/\s+/g, " ")
    .trim();

const toCardSummary = (source: string, limit = 132) => {
  const normalized = normalizeCardSummary(source);
  return normalized.length <= limit ? normalized : `${normalized.slice(0, limit).trim()}…`;
};

const fallbackHero = {
  system_label: "Implicit Signal Mining for Personalized Decision Systems",
  name: "Chika Komari",
  tagline: "A unified path across structural, semantic, and psychological signal mining",
  intro: "I focus on implicit signal mining in complex information networks for risk-aware and personalized decision systems.",
  now: ["Advancing structural, semantic, and psychological signal-mining milestones"],
};

const hero = home?.hero ? { ...fallbackHero, ...home.hero } : fallbackHero;
const currentObservation = hero.now?.[0]?.trim();

const observatoryHero: ObservatoryHeroCopy = {
  eyebrow: hero.system_label,
  title: hero.name,
  subtitle: hero.tagline,
  description: [hero.intro, currentObservation ? `Current orbit — ${currentObservation}` : ""].filter(Boolean).join(" "),
  primaryAction: {
    label: home?.hero?.cta_primary_label?.trim() || "进入研究档案",
    href: home?.hero?.cta_primary_url?.trim() || "/artifacts/",
  },
  secondaryAction: {
    label: home?.hero?.cta_secondary_label?.trim() || "阅读最新文章",
    href: home?.hero?.cta_secondary_url?.trim() || "/blog/",
  },
};

const fallbackMetrics: ObservatoryMetric[] = [
  { label: "Publications / Preprint", value: "3", detail: "1 under review · 1 accepted · 1 preprint" },
  { label: "GPA / Rank", value: "4.04/5.00 · 15/154", detail: "Sun Yat-sen University" },
  { label: "Kaggle Models", value: "2.7K+ / 1.0K+", detail: "Views / downloads across the CSIRO series" },
  { label: "Current Role", value: "AI Intern", detail: "Evolution Asset Management · since Apr 2025" },
];

const observatoryMetrics: ObservatoryMetric[] = home?.hero?.metrics?.length
  ? home.hero.metrics.map(({ label, value, detail }) => ({ label, value, detail })).slice(0, 6)
  : fallbackMetrics;

const summary = computeRoadmapPointSummary(nodes);
const rootSlugSet = summary.rootSlugs;
type RoadmapNode = (typeof nodes)[number];

const observatoryTracks: ObservatoryTrack[] = Array.from(
  nodes.reduce((map, node) => {
    const list = map.get(node.data.track) ?? [];
    list.push(node);
    map.set(node.data.track, list);
    return map;
  }, new Map<string, typeof nodes>()).entries(),
)
  .map(([track, list]) => {
    const roots = list
      .filter((node: RoadmapNode) => rootSlugSet.has(normalizeSlug(node)))
      .sort((a: RoadmapNode, b: RoadmapNode) => (a.data.sort_order ?? 0) - (b.data.sort_order ?? 0));
    const firstRoot = roots[0];
    const trackMetric = summary.trackMetrics.get(track);

    return {
      title: track,
      progress: trackMetric?.progress ?? 0,
      summary: firstRoot
        ? `${firstRoot.data.title} · ${trackMetric?.rootCount ?? roots.length} roots / ${trackMetric?.nodeCount ?? list.length} nodes`
        : `${trackMetric?.nodeCount ?? list.length} active research nodes`,
      href: firstRoot ? `/roadmap/${normalizeSlug(firstRoot)}/` : "/roadmap/",
      status: firstRoot?.data.status,
    };
  })
  .filter((track) => track.title)
  .sort((a, b) => a.title.localeCompare(b.title, "zh-CN"));

const featuredSlugs = new Set(home?.featured_artifacts ?? []);
const featuredArtifacts = artifacts.filter((entry) => featuredSlugs.has(normalizeSlug(entry))).slice(0, 4);

const observatoryArtifacts: ObservatoryEntry[] = featuredArtifacts.map((entry) => ({
  title: entry.data.title,
  summary: toCardSummary(entry.data.summary),
  href: `/artifacts/${normalizeSlug(entry)}/`,
  meta: entry.data.type,
  cover: entry.data.cover,
}));

const observatoryPosts: ObservatoryEntry[] = posts.slice(0, 5).map((entry) => ({
  title: entry.data.title,
  summary: toCardSummary(entry.data.summary?.trim() || entry.body.slice(0, 900)),
  href: `/blog/${normalizeSlug(entry)}/`,
  meta: formatDate(entry.data.date),
  cover: entry.data.cover,
}));

const signals: ObservatorySignalWindow[] = [
  {
    src: "/assets/img/observatory/signal-bocchi.webp",
    alt: "舞台灯光下抱着吉他的粉发少女",
    eyebrow: "Band signal",
    caption: "孤独并不等于沉默",
    href: "/blog/",
    focalPosition: "center 20%",
  },
  {
    src: "/assets/img/observatory/signal-april.webp",
    alt: "夕光中的少年与金发少女",
    eyebrow: "Memory signal",
    caption: "四月留下的共振",
    focalPosition: "center 30%",
  },
  {
    src: "/assets/img/observatory/signal-gbc.webp",
    alt: "舞台灯光下并肩而立的少女乐队成员",
    eyebrow: "Band signal",
    caption: "把噪声写成自己的歌",
    focalPosition: "center 25%",
  },
  {
    src: "/assets/img/observatory/signal-komari.webp",
    alt: "教室窗边的黑发少女",
    eyebrow: "Daily signal",
    caption: "日常是最微弱也最持久的观测",
    focalPosition: "center 20%",
  },
  {
    src: "/assets/img/observatory/signal-kaguya.webp",
    alt: "暖色月光中的两位少女",
    eyebrow: "Afterlight",
    caption: "月光之后，信号仍在",
    focalPosition: "right 20%",
  },
];

const githubUrl = home?.quick_links.find((item) => item.label.toLowerCase().includes("github"))?.url
  ?? "https://github.com/Joker-of-Gotham";
const githubUsername = githubUrl.split("/").filter(Boolean).pop() ?? "Joker-of-Gotham";
---

<BaseLayout
  title="Lunar Signal Observatory"
  description="A cinematic research observatory for implicit signal mining, engineering systems, and afterlight archives."
  variant="observatory"
>
  <LunarObservatory
    slot="full-bleed"
    hero={observatoryHero}
    metrics={observatoryMetrics}
    tracks={observatoryTracks}
    artifacts={observatoryArtifacts}
    posts={observatoryPosts}
    signals={signals}
  >
    <section slot="supplement" class="observatory-supplement" aria-labelledby="commit-activity-title">
      <div class="observatory-supplement-copy">
        <p class="observatory-kicker"><span aria-hidden="true">LSO / LIVE</span>Public telemetry</p>
        <h2 id="commit-activity-title">持续工作的轨迹，也是一种可验证信号</h2>
        <p>当外部数据源不可用时，这一模块会保留清晰的降级状态，并始终提供 GitHub 原始入口。</p>
      </div>
      <CommitActivity username={githubUsername} githubUrl={githubUrl} />
    </section>
  </LunarObservatory>
</BaseLayout>
