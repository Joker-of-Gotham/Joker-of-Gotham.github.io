---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Card from "@/components/ui/Card.astro";
import Comments from "@/components/ui/Comments.astro";
import ResponsiveCover from "@/components/media/ResponsiveCover.astro";
import type { CollectionEntry } from "astro:content";
import { getArtifacts, getRoadmapNodes, getPublishedBlogPosts, normalizeSlug, formatDate } from "@/lib/content/queries";
import "@/styles/archive.css";

export async function getStaticPaths() {
  const artifacts = await getArtifacts();
  return artifacts.map((entry) => ({ params: { slug: normalizeSlug(entry) }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<"artifacts"> };
const { Content } = await entry.render();

const [nodes, posts] = await Promise.all([getRoadmapNodes(), getPublishedBlogPosts()]);
const currentSlug = normalizeSlug(entry);

const relatedNodes = nodes.filter((node) => {
  const nodeSlug = normalizeSlug(node);
  return entry.data.related_nodes.includes(nodeSlug) || node.data.related_artifacts.includes(currentSlug);
});

const nodeSlugSet = new Set(relatedNodes.map((node) => normalizeSlug(node)));
const relatedPosts = posts.filter((post) => {
  const explicit = post.data.related_artifacts.includes(currentSlug);
  const viaNode = post.data.related_nodes.some((nodeSlug: string) => nodeSlugSet.has(nodeSlug));
  return explicit || viaNode;
});

function normalizeContentLink(rawUrl: string) {
  const rewriteLegacyPath = (pathname: string) => {
    const normalizedPath = pathname.replace(/\/index\.html$/i, "/").replace(/\.html$/i, "/");
    const decodedPath = decodeURIComponent(normalizedPath);

    const datedSlug = decodedPath.match(/\/(\d{4}-\d{2}-\d{2}-[^/]+)\/?$/u);
    if (datedSlug) {
      return `/blog/${datedSlug[1]}/`;
    }

    const legacyCollectionPath = decodedPath.match(/\/_(?:graph_theory|llm_learning|technical_talk|posts)\/([^/]+?)(?:\.md)?\/?$/iu);
    if (legacyCollectionPath) {
      return `/blog/${legacyCollectionPath[1]}/`;
    }

    if (/\/roadmap\/?$/i.test(decodedPath)) return "/roadmap/";
    if (/\/blog\/?$/i.test(decodedPath)) return "/blog/";
    if (/\/about\/?$/i.test(decodedPath)) return "/about/";

    return normalizedPath;
  };

  try {
    const parsed = new URL(rawUrl);
    if (parsed.hostname === "joker-of-gotham.github.io") {
      const pathname = rewriteLegacyPath(parsed.pathname);
      return `${pathname}${parsed.search}${parsed.hash}`;
    }
  } catch {
    if (rawUrl.startsWith("/")) {
      return rewriteLegacyPath(rawUrl);
    }
  }
  return rawUrl;
}

const normalizedLinks: Array<{ label: string; url: string; isInternal: boolean }> = entry.data.links.map((link: (typeof entry.data.links)[number]) => {
  const url = normalizeContentLink(link.url);
  const isInternal = url.startsWith("/");
  return {
    ...link,
    url,
    isInternal
  };
});
---

<BaseLayout
  title={entry.data.title}
  crumbs={[{ label: "Home", href: "/" }, { label: "Artifacts", href: "/artifacts/" }, { label: entry.data.title }]}
  pagefindFilters={{
    kind: entry.data.type === "project" ? "project" : entry.data.type === "paper" ? "paper" : "artifact",
    type: entry.data.type,
    year: entry.data.date.getFullYear(),
    tags: entry.data.tags
  }}
>
  <article class="archive-page archive-document archive-document--artifact">
    <header class="archive-document-header">
      {entry.data.cover ? (
        <div class="archive-document-cover archive-document-cover--image full-bleed">
          <ResponsiveCover
            src={entry.data.cover}
            alt={entry.data.title}
            loading="eager"
            fetchpriority="high"
            sizes="(max-width: 960px) 100vw, 1440px"
          />
          <div class="archive-document-cover-scrim" aria-hidden="true" />
          <div class="archive-document-cover-copy">
            <p class="archive-kicker"><span aria-hidden="true">B / ARTIFACT</span> Materialized signal</p>
            <h1>{entry.data.title}</h1>
            <dl class="archive-signal-meta" aria-label="Artifact metadata">
              <div><dt>Format</dt><dd>{entry.data.type.toUpperCase()}</dd></div>
              <div><dt>Released</dt><dd><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time></dd></div>
              {entry.data.venue && <div><dt>Venue</dt><dd>{entry.data.venue}</dd></div>}
            </dl>
          </div>
        </div>
      ) : (
        <div class="archive-document-cover archive-document-cover--placeholder archive-document-cover--artifact full-bleed">
          <div class="archive-document-cover-copy">
            <p class="archive-kicker"><span aria-hidden="true">B / ARTIFACT</span> Materialized signal</p>
            <h1>{entry.data.title}</h1>
            <dl class="archive-signal-meta" aria-label="Artifact metadata">
              <div><dt>Format</dt><dd>{entry.data.type.toUpperCase()}</dd></div>
              <div><dt>Released</dt><dd><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time></dd></div>
              {entry.data.venue && <div><dt>Venue</dt><dd>{entry.data.venue}</dd></div>}
            </dl>
          </div>
        </div>
      )}

      <div class="archive-document-deck">
        <p>{entry.data.summary}</p>
        <div class="archive-document-tags" aria-label="Artifact tags">
          <span class="archive-document-tags-label">Signal taxonomy</span>
          {entry.data.tags.map((tag: string) => <span class="tag-chip">{tag}</span>)}
        </div>
      </div>
    </header>

    {normalizedLinks.length > 0 && (
      <nav class="archive-link-console" aria-labelledby="artifact-links-title">
        <div class="archive-section-heading archive-section-heading--compact">
          <div><p class="archive-kicker">External bearings</p><h2 id="artifact-links-title">Links</h2></div>
          <span class="archive-coordinate">{normalizedLinks.length.toString().padStart(2, "0")}</span>
        </div>
        <ul>
          {
            normalizedLinks.map((link: (typeof normalizedLinks)[number]) => (
              <li>
                <a href={link.url} target={link.isInternal ? undefined : "_blank"} rel={link.isInternal ? undefined : "noreferrer"}>
                  <span>{link.label}</span>
                  <span aria-hidden="true">{link.isInternal ? "→" : "↗"}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    )}

    <div class="archive-reading-shell">
      <div class="archive-reading-marker" aria-hidden="true">
        <span>OBSERVATION OBJECT</span>
        <span>{currentSlug}</span>
      </div>
      <div class="article-content content archive-prose">
        <Content />
      </div>
    </div>

    <footer class="archive-document-footer">
      <section class="archive-related-section" aria-labelledby="artifact-related-roadmap-title" data-animate>
        <div class="archive-section-heading archive-section-heading--compact">
          <div><p class="archive-kicker">Linked trajectory</p><h2 id="artifact-related-roadmap-title">关联路线图节点</h2></div>
          <span class="archive-coordinate">{relatedNodes.length.toString().padStart(2, "0")}</span>
        </div>
        {relatedNodes.length > 0 ? (
          <div class="card-grid archive-related-grid">
            {relatedNodes.map((node) => <Card href={`/roadmap/${normalizeSlug(node)}/`} title={node.data.title} subtitle={node.data.track} />)}
          </div>
        ) : (
          <Card title="暂无关联路线图节点" />
        )}
      </section>

      <section class="archive-related-section" aria-labelledby="artifact-related-blog-title" data-animate>
        <div class="archive-section-heading archive-section-heading--compact">
          <div><p class="archive-kicker">Research log</p><h2 id="artifact-related-blog-title">关联博客</h2></div>
          <span class="archive-coordinate">{relatedPosts.length.toString().padStart(2, "0")}</span>
        </div>
        {relatedPosts.length > 0 ? (
          <div class="card-grid archive-related-grid">
            {relatedPosts.map((post) => <Card href={`/blog/${normalizeSlug(post)}/`} title={post.data.title} subtitle={formatDate(post.data.date)} />)}
          </div>
        ) : (
          <Card title="暂无关联博客" />
        )}
      </section>

      <Comments term={entry.data.title} />
    </footer>
  </article>
</BaseLayout>
