---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ResponsiveCover from "@/components/media/ResponsiveCover.astro";
import { getArtifacts, normalizeSlug, formatDate } from "@/lib/content/queries";
import "@/styles/archive.css";

const artifacts = await getArtifacts();
---

<BaseLayout
  title="Artifacts"
  description="Lunar Signal Observatory 成果档案：项目、论文、数据与可复用的研究输出。"
  crumbs={[{ label: "Home", href: "/" }, { label: "Artifacts" }]}
>
  <div class="archive-page archive-page--index archive-artifact-index">
    <header class="archive-masthead archive-masthead--instrument" aria-labelledby="artifact-archive-title">
      <div class="archive-masthead-copy">
        <p class="archive-kicker"><span aria-hidden="true">B—02</span> Materialized signals</p>
        <h1 id="artifact-archive-title">Artifacts</h1>
      </div>
    </header>

    <section class="archive-catalogue">

      <ol class="archive-record-list">
      {
        artifacts.map((entry, idx) => (
          <li class={`archive-record ${idx === 0 ? "archive-record--featured" : ""}`}>
            <article>
              <a class="archive-record-link" href={`/artifacts/${normalizeSlug(entry)}/`}>
                <div class="archive-record-media">
                  {
                    entry.data.cover ? (
                      <ResponsiveCover
                        src={entry.data.cover}
                        alt={entry.data.title}
                        loading={idx === 0 ? "eager" : "lazy"}
                        fetchpriority={idx === 0 ? "high" : "auto"}
                        sizes={idx === 0
                          ? "(max-width: 720px) 100vw, (max-width: 1180px) 58vw, 720px"
                          : "(max-width: 720px) 100vw, (max-width: 1180px) 34vw, 420px"}
                      />
                    ) : (
                      <div class="archive-record-placeholder" data-variant={((idx % 6) + 1).toString()} aria-label={`${entry.data.type} placeholder`}>
                        <span>{entry.data.type}</span>
                      </div>
                    )
                  }
                  <span class="archive-record-index" aria-hidden="true">{String(idx + 1).padStart(2, "0")}</span>
                </div>

                <div class="archive-record-copy">
                  <div class="archive-record-meta">
                    <span>{entry.data.type}</span>
                    <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
                  </div>
                  <h3>{entry.data.title}</h3>
                  <p>{entry.data.summary}</p>
                  {entry.data.tags.length > 0 && (
                    <ul class="archive-record-tags" aria-label="Tags">
                      {entry.data.tags.slice(0, 3).map((tag: string) => <li>{tag}</li>)}
                    </ul>
                  )}
                  <span class="archive-record-action">Open artifact <span aria-hidden="true">↗</span></span>
                </div>
              </a>
            </article>
          </li>
        ))
      }
      </ol>
    </section>
  </div>
</BaseLayout>
