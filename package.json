    "assets:world-variants": "node scripts/derive-world-plate-variants.mjs",
    "assets:world-plates": "node scripts/prepare-world-plates.mjs",
    "assets:observatory:video": "node scripts/prepare-observatory-video.mjs",
    "assets:covers": "node scripts/prepare-cover-assets.mjs",
    "cms:local": "decap-server",
    "postbuild": "pagefind --site dist --glob \"**/index.html\" --silent"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^5.18.2",
