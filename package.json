    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.15.3",
    "@types/three": "^0.185.4",
    "decap-server": "^3.10.0",
    "gray-matter": "^4.0.3",
